  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/aws-lambda": "^8.10.161",
    "axios": "^1.16.1",
    "bestzip": "^3.0.1",
    "inversify": "^8.1.0",
    "prettier": "^3.8.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}