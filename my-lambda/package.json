  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist && rimraf coverage && rimraf ${npm_package_name}.zip",
    "build": "npm run build-app && cp package.json dist && cd dist && npm run install-prod && cd ../ && npm run zip",
    "build-app": "npm run clean && tsc -p tsconfig.app.json",
    "postbuild": "mkdir -p dist; mv ${npm_package_name}.zip dist/",
    "zip": "bestzip ${npm_package_name}.zip dist/*",
    "install-prod": "npm i --production",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write ."
  },
  "keywords": [],
